# Robotrac Recruitment Portal - environment variables (EXAMPLE ONLY, no real secrets).
#
# Spring Boot does not read .env files by itself. Either:
#   (a) recommended for local development: put the same settings in backend\config\application.properties
#       (copy backend\config\application.properties.example), which is git-ignored; or
#   (b) set them in PowerShell before starting the backend, e.g.
#         $env:DB_PASSWORD = "your-password"
#         .\mvnw.cmd spring-boot:run

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/robotrac_recruitment?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&characterEncoding=UTF-8
DB_USERNAME=robotrac_app
DB_PASSWORD=change-me

# --- Server ---
SERVER_PORT=8080
# true only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
# Extra origins allowed to call the API with cookies (comma separated). Never use *.
APP_CORS_ORIGINS=http://localhost:5500

# --- Paths (relative to the backend folder) ---
APP_FRONTEND_DIR=file:../frontend/
APP_SEED_QUESTIONS=true
APP_SEED_FILE=../database/question-bank/Robotrac_Company_Level_Aptitude_Bank_150_40min.xlsx
